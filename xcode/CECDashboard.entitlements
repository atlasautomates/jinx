<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Not App-Sandboxed: Developer-ID distribution. The app needs only outbound
         network (Supabase REST) and Keychain read (the arcane_read_cec reader JWT). NOTE (P1
         renovation): the `claude` CLI subprocess — the original sandbox blocker —
         was removed with the Haiku layout engine, so App Sandbox
         (com.apple.security.app-sandbox + network.client + keychain access group)
         is now viable; evaluate on the next release pass. Hardened Runtime is on
         via build setting (required for notarization). -->
</dict>
</plist>
